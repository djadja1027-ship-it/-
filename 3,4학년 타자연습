        const btnCustomMission = document.getElementById('btnCustomMission');
        const customModal = document.getElementById('customModal');
        const btnSaveCustom = document.getElementById('btnSaveCustom');
        const btnCancelCustom = document.getElementById('btnCancelCustom');
        const customMissions = document.getElementById('customMissions');
        const dragonNest = document.getElementById('dragonNest');

        function createStars() {
            const starsContainer = document.getElementById('starsContainer');
            for (let i = 0; i < 100; i++) {
                const star = document.createElement('div');
                star.className = 'star';
                star.style.left = Math.random() * 100 + '%';
                star.style.top = Math.random() * 100 + '%';
                star.style.width = Math.random() * 3 + 'px';
                star.style.height = star.style.width;
                star.style.animationDelay = Math.random() * 3 + 's';
                starsContainer.appendChild(star);
            }
        }

        function createMagicParticles(x, y) {
            for (let i = 0; i < 10; i++) {
                const particle = document.createElement('div');
                particle.className = 'magic-particle';
                particle.style.left = x + 'px';
                particle.style.top = y + 'px';
                particle.style.animationDelay = (i * 0.1) + 's';
                dragonNest.appendChild(particle);
                setTimeout(() => particle.remove(), 2000);
            }
        }

        function getCurrentMission() {
            if (isCustomMode) {
                return customMissionList[currentMission] || "완료!";
            }
            return levelMissions[currentLevel][currentMission];
        }

        function startGame() {
            gameStarted = true;
            inputArea.disabled = false;
            inputArea.value = '';
            inputArea.focus();
            btnStart.textContent = '⏭️ 다음 문제';
            updateMissionDisplay();
        }

        function updateMissionDisplay() {
            const mission = getCurrentMission();
            missionText.textContent = mission;
            
            if (isCustomMode) {
                levelBadge.textContent = '🧙‍♂️ 마법사 미션';
                missionCounter.textContent = \`미션 \${currentMission + 1}/\${customMissionList.length}\`;
            } else {
                levelBadge.textContent = \`레벨 \${currentLevel + 1}\`;
                missionCounter.textContent = \`미션 \${currentMission + 1}/30\`;
            }
        }

        function updateGrowthStage() {
            const stages = ['egg', 'baby', 'teen', 'master'];
            
            stages.forEach(stage => {
                document.getElementById(\`stage-\${stage}\`).classList.remove('active');
            });
            
            document.getElementById(\`stage-\${stages[dragonStage]}\`).classList.add('active');
            
            document.getElementById('eggCount').textContent = \`\${stageEggs[0]}/10\`;
            document.getElementById('babyCount').textContent = \`\${stageEggs[1]}/10\`;
            document.getElementById('teenCount').textContent = \`\${stageEggs[2]}/10\`;
            document.getElementById('masterCount').textContent = \`\${stageEggs[3]}/10\`;
            
            document.getElementById('totalEggs').textContent = totalEggs;
            document.getElementById('successCount').textContent = correctCount;
            
            if (totalAttempts > 0) {
                const accuracy = Math.round((correctCount / totalAttempts) * 100);
                document.getElementById('accuracy').textContent = \`\${accuracy}%\`;
            }
        }

        function showCelebration(emoji) {
            const celebration = document.createElement('div');
            celebration.className = 'celebration';
            celebration.textContent = emoji;
            document.body.appendChild(celebration);
            
            const rect = dragonNest.getBoundingClientRect();
            createMagicParticles(rect.left + rect.width/2, rect.top + rect.height/2);
            
            setTimeout(() => {
                celebration.remove();
            }, 1500);
        }

        function addEgg() {
            totalEggs++;
            stageEggs[dragonStage]++;
            
            if (stageEggs[dragonStage] >= 10) {
                stageEggs[dragonStage] = 0;
                
                if (dragonStage < 3) {
                    dragonStage++;
                    const emojis = ['✨', '🐲', '🐉', '🏆🔥🐉🔥🏆'];
                    showCelebration(emojis[dragonStage]);
                    
                    const messages = [
                        '',
                        '🎉 드래곤의 알이 부화했어요! 아기 드래곤이 태어났습니다!',
                        '⚡ 아기 드래곤이 청룡으로 성장했어요! 강력해지고 있어요!',
                        '👑 축하합니다! 전설의 황금룡으로 진화했습니다! 드래곤 마스터!'
                    ];
                    if (messages[dragonStage]) {
                        setTimeout(() => alert(messages[dragonStage]), 500);
                    }
                } else {
                    showCelebration('👑💎🏆');
                }
            }
            
            updateGrowthStage();
        }

        inputArea.addEventListener('input', function() {
            const userInput = this.value;
            const mission = getCurrentMission();
            
            if (userInput === mission) {
                this.classList.remove('wrong');
                this.classList.add('correct');
                totalAttempts++;
                correctCount++;
                addEgg();
                
                setTimeout(() => {
                    nextMission();
                }, 600);
            } else if (mission.startsWith(userInput)) {
                this.classList.remove('wrong');
                this.classList.remove('correct');
            } else {
                this.classList.add('wrong');
                this.classList.remove('correct');
            }
        });

        function nextMission() {
            inputArea.value = '';
            inputArea.classList.remove('correct', 'wrong');
            
            const maxMissions = isCustomMode ? customMissionList.length : 30;
            
            currentMission++;
            
            if (currentMission >= maxMissions) {
                if (isCustomMode) {
                    alert('🎊 마법사의 모든 미션을 완료했어요! 대단해요!');
                    resetGame();
                } else if (currentLevel < 29) {
                    alert(\`⭐ 레벨 \${currentLevel + 1} 클리어! 다음 레벨로 진입합니다!\`);
                    currentLevel++;
                    currentMission = 0;
                    updateMissionDisplay();
                } else {
                    alert('🏆👑 축하합니다! 모든 30레벨을 정복했어요!\\n당신은 진정한 드래곤 마스터입니다! 🐉✨');
                    resetGame();
                }
            } else {
                updateMissionDisplay();
            }
            
            inputArea.focus();
        }

        function resetGame() {
            currentLevel = 0;
            currentMission = 0;
            isCustomMode = false;
            gameStarted = false;
            inputArea.disabled = true;
            inputArea.value = '';
            btnStart.textContent = '🚀 시작하기';
            missionText.textContent = '시작하기를 눌러주세요';
            updateMissionDisplay();
        }

        btnStart.addEventListener('click', function() {
            if (!gameStarted) {
                startGame();
            } else {
                nextMission();
            }
        });

        btnCustomMission.addEventListener('click', function() {
            customModal.classList.add('active');
            customMissions.value = '';
            customMissions.focus();
        });

        btnSaveCustom.addEventListener('click', function() {
            const missions = customMissions.value.trim().split('\\n').filter(m => m.trim());
            
            if (missions.length === 0) {
                alert('⚠️ 미션을 최소 1개 이상 입력해주세요!');
                return;
            }
            
            if (missions.length > 30) {
                alert('⚠️ 미션은 최대 30개까지 입력 가능해요!');
                return;
            }
            
            customMissionList = missions;
            isCustomMode = true;
            currentMission = 0;
            customModal.classList.remove('active');
            startGame();
        });

        btnCancelCustom.addEventListener('click', function() {
            customModal.classList.remove('active');
        });

        customModal.addEventListener('click', function(e) {
            if (e.target === customModal) {
                customModal.classList.remove('active');
            }
        });

        inputArea.addEventListener('keypress', function(e) {
            if (e.key === 'Enter' && this.classList.contains('correct')) {
                nextMission();
            }
        });

        createStars();
        updateGrowthStage();
    </script>
