<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🐥 한글 타자 연습</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700;900&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0;}
body{
  font-family:'Noto Sans KR',sans-serif;
  min-height:100vh;
  background:#FFF9F0;
  background-image:
    radial-gradient(circle at 10% 20%, #FFE5F0 0%, transparent 35%),
    radial-gradient(circle at 90% 10%, #E5F5FF 0%, transparent 35%),
    radial-gradient(circle at 50% 90%, #E8FFE5 0%, transparent 40%);
}
#app{max-width:560px;margin:0 auto;padding:24px 16px 48px;position:relative;}

.deco{position:fixed;pointer-events:none;font-size:32px;opacity:0.15;animation:float 4s ease-in-out infinite;z-index:0;}
.deco:nth-child(1){top:5%;left:4%;animation-delay:0s;}
.deco:nth-child(2){top:8%;right:6%;animation-delay:0.7s;}
.deco:nth-child(3){top:42%;left:2%;animation-delay:1.2s;}
.deco:nth-child(4){top:60%;right:2%;animation-delay:0.4s;}
.deco:nth-child(5){bottom:14%;left:6%;animation-delay:1.8s;}
.deco:nth-child(6){bottom:8%;right:8%;animation-delay:0.9s;}
@keyframes float{0%,100%{transform:translateY(0) rotate(0deg);}50%{transform:translateY(-12px) rotate(8deg);}}

.title-wrap{text-align:center;margin-bottom:20px;position:relative;z-index:1;}
.title-main{font-size:30px;font-weight:900;color:#3B1F8C;letter-spacing:-0.5px;display:block;}
.title-sub{font-size:15px;color:#7B5EA7;margin-top:4px;}

.tabs{display:flex;gap:10px;margin-bottom:20px;position:relative;z-index:1;}
.tab{
  flex:1;padding:16px 8px;
  border-radius:18px;
  border:3px solid #D4BBFF;
  background:#fff;
  color:#7B5EA7;
  font-size:17px;font-weight:700;
  cursor:pointer;font-family:inherit;
  transition:all 0.18s;
}
.tab.active{background:#7F77DD;color:#fff;border-color:#534AB7;}
.tab:hover:not(.active){background:#F0EAFF;}

.card{
  background:#fff;
  border-radius:24px;
  border:3px solid #E8D5FF;
  padding:22px 20px;
  margin-bottom:16px;
  position:relative;z-index:1;
}
.panel-title{font-size:18px;font-weight:700;color:#3B1F8C;margin-bottom:16px;}

.teacher-row{display:flex;gap:10px;margin-bottom:16px;}
#teacher-input{
  flex:1;padding:18px 18px;
  font-size:20px;font-weight:700;
  border-radius:16px;
  border:3px solid #D4BBFF;
  color:#3B1F8C;background:#FAF6FF;
  font-family:inherit;outline:none;
  transition:border-color 0.15s;
}
#teacher-input:focus{border-color:#7F77DD;}
.btn-add{
  padding:18px 22px;
  background:#7F77DD;color:#fff;
  border:none;border-radius:16px;
  font-size:18px;font-weight:700;
  cursor:pointer;font-family:inherit;
  white-space:nowrap;transition:background 0.15s;
}
.btn-add:hover{background:#534AB7;}

.queue-label{font-size:14px;color:#7B5EA7;margin-bottom:10px;font-weight:700;}
.queue-tags{display:flex;flex-wrap:wrap;gap:8px;min-height:40px;margin-bottom:16px;}
.qtag{
  background:#F0EAFF;border-radius:99px;
  padding:10px 18px;font-size:16px;font-weight:700;
  color:#534AB7;display:flex;align-items:center;gap:8px;
}
.qtag button{background:none;border:none;cursor:pointer;color:#AFA9EC;font-size:20px;line-height:1;padding:0;font-weight:700;}

.btn-row{display:flex;gap:10px;flex-wrap:wrap;}
.btn-outline{
  padding:14px 20px;background:none;
  border:3px solid #D4BBFF;border-radius:14px;
  font-size:15px;color:#7B5EA7;font-weight:700;
  cursor:pointer;font-family:inherit;
}
.btn-outline:hover{background:#F0EAFF;}
.btn-go{
  padding:14px 24px;background:#1D9E75;color:#fff;
  border:none;border-radius:14px;
  font-size:15px;font-weight:700;
  cursor:pointer;font-family:inherit;
}
.btn-go:hover{background:#0F6E56;}

.share-inner{background:#F0FFF8;border-radius:16px;border:2px solid #9FE1CB;padding:16px;}
.share-title{font-size:15px;font-weight:700;color:#0F6E56;margin-bottom:6px;}
.share-desc{font-size:13px;color:#1D9E75;margin-bottom:12px;}
.share-row{display:flex;gap:8px;align-items:stretch;}
#share-url{
  flex:1;padding:10px 12px;font-size:12px;
  border-radius:12px;border:2px solid #9FE1CB;
  background:#fff;color:#0F6E56;
  font-family:monospace;resize:none;height:60px;outline:none;
}
.btn-copy{
  padding:10px 18px;background:#1D9E75;color:#fff;
  border:none;border-radius:12px;font-size:15px;font-weight:700;
  cursor:pointer;font-family:inherit;white-space:nowrap;
}
.btn-copy:hover{background:#0F6E56;}
.copy-ok{font-size:13px;color:#1D9E75;margin-top:8px;min-height:20px;font-weight:700;}

#student-panel{display:none;position:relative;z-index:1;}
.info-banner{
  background:#EEEDFE;border-radius:16px;
  border:2px solid #AFA9EC;
  padding:14px 16px;font-size:15px;
  color:#534AB7;font-weight:700;
  margin-bottom:16px;text-align:center;
}

.word-card{
  background:#fff;border-radius:24px;
  border:3px solid #FFD6E8;
  padding:28px 20px 20px;
  margin-bottom:16px;text-align:center;
}
.prompt-label{font-size:16px;color:#D4537E;font-weight:700;margin-bottom:14px;}
.prompt-word{
  font-size:56px;font-weight:900;color:#3B1F8C;
  letter-spacing:6px;min-height:70px;
  display:flex;align-items:center;justify-content:center;
  flex-wrap:wrap;gap:4px;margin-bottom:20px;
  line-height:1.2;
}
.ch-correct{color:#1D9E75;}
.ch-wrong{color:#D85A30;text-decoration:underline;}
.ch-current{border-bottom:4px solid #7F77DD;color:#3B1F8C;padding-bottom:2px;}
.ch-pending{color:#C4B0E8;}

#student-input{
  width:100%;padding:22px 16px;
  font-size:30px;font-weight:700;
  border-radius:18px;
  border:4px solid #D4BBFF;
  background:#FAF6FF;color:#3B1F8C;
  font-family:inherit;outline:none;
  text-align:center;
  transition:border-color 0.18s, background 0.18s;
}
#student-input:focus{border-color:#7F77DD;}
#student-input.ok{border-color:#1D9E75;background:#F0FFF8;}
#student-input.ng{border-color:#D85A30;background:#FFF5F5;}

.feedback-msg{font-size:20px;font-weight:700;min-height:32px;margin-top:14px;text-align:center;}
.feedback-msg.good{color:#1D9E75;}
.feedback-msg.bad{color:#D85A30;}

.skip-btn{
  display:block;width:100%;margin-top:14px;
  padding:16px;background:#FAF6FF;
  border:3px solid #D4BBFF;border-radius:16px;
  font-size:17px;font-weight:700;color:#7B5EA7;
  cursor:pointer;font-family:inherit;
  transition:background 0.15s;
}
.skip-btn:hover{background:#F0EAFF;}

.reward-card{
  background:#fff;border-radius:24px;
  border:3px solid #FFE5A0;padding:22px 20px;
  position:relative;z-index:1;
}
.reward-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;}
.reward-title{font-size:18px;font-weight:700;color:#3B1F8C;}
.stage-badge{font-size:15px;padding:10px 18px;border-radius:99px;font-weight:700;}
.badge-egg{background:#FAEEDA;color:#854F0B;}
.badge-chick{background:#EAF3DE;color:#3B6D11;}
.badge-mid{background:#E1F5EE;color:#0F6E56;}
.badge-hen{background:#EEEDFE;color:#534AB7;}

.prog-outer{background:#FFF3D0;border-radius:99px;height:18px;margin-bottom:8px;overflow:hidden;border:2px solid #FFE5A0;}
.prog-inner{height:100%;border-radius:99px;background:#EF9F27;transition:width 0.4s ease;}
.prog-label{font-size:14px;color:#854F0B;text-align:right;margin-bottom:16px;font-weight:700;}

.eggs-grid{display:flex;flex-wrap:wrap;gap:8px;}
.egg-slot{
  width:48px;height:48px;
  display:flex;align-items:center;justify-content:center;
  font-size:28px;border-radius:50%;
  background:#FFF9F0;border:2px solid #FFE5A0;
  transition:all 0.3s;
}
.egg-slot.filled{background:#FAEEDA;border-color:#EF9F27;animation:popIn 0.4s;}
@keyframes popIn{0%{transform:scale(0);}70%{transform:scale(1.3);}100%{transform:scale(1);}}

.no-words{text-align:center;color:#AFA9EC;font-size:18px;font-weight:700;padding:3rem 0;}
.done-wrap{text-align:center;padding:2.5rem 1rem;}
.done-big{font-size:72px;display:block;margin-bottom:16px;animation:bigBounce 0.8s infinite alternate;}
.done-txt{font-size:20px;font-weight:700;color:#3B1F8C;line-height:1.6;}

/* 부화 오버레이 */
.burst-overlay{
  display:none;
  position:fixed;inset:0;
  align-items:center;justify-content:center;
  background:rgba(59,31,140,0.4);
  z-index:999;
}
.burst-box{
  background:#fff;border-radius:32px;
  border:4px solid #FFD6E8;
  padding:40px 44px;text-align:center;
  margin:24px;
  animation:popIn 0.4s;
}
.burst-emoji{font-size:90px;animation:bigBounce 0.6s infinite alternate;margin-bottom:16px;display:block;}
@keyframes bigBounce{from{transform:translateY(0) scale(1);}to{transform:translateY(-14px) scale(1.08);}}
.burst-title{font-size:28px;font-weight:900;color:#3B1F8C;margin-bottom:8px;}
.burst-sub{font-size:17px;color:#7B5EA7;font-weight:700;margin-bottom:24px;}
.btn-continue{
  padding:20px 48px;background:#7F77DD;color:#fff;
  border:none;border-radius:20px;
  font-size:22px;font-weight:700;
  cursor:pointer;font-family:inherit;
  transition:background 0.15s;
}
.btn-continue:hover{background:#534AB7;}
</style>
</head>
<body>

<span class="deco">🌸</span>
<span class="deco">⭐</span>
<span class="deco">🌈</span>
<span class="deco">🌻</span>
<span class="deco">🍀</span>
<span class="deco">🎀</span>

<div id="app">
  <div class="title-wrap">
    <span class="title-main">🐥 한글 타자 연습</span>
    <span class="title-sub">글자를 보고 따라 써봐요!</span>
  </div>

  <div class="tabs">
    <button class="tab active" id="tab-t" onclick="switchTab('teacher')">👩‍🏫 선생님</button>
    <button class="tab" id="tab-s" onclick="switchTab('student')">🧒 학생</button>
  </div>

  <!-- 선생님 패널 -->
  <div id="teacher-panel">
    <div class="card">
      <div class="panel-title">✏️ 연습할 단어를 입력하세요</div>
      <div class="teacher-row">
        <input type="text" id="teacher-input" placeholder="단어 입력 후 추가!" />
        <button class="btn-add" onclick="addWord()">추가 ＋</button>
      </div>
      <div class="queue-label">📋 추가된 단어 목록</div>
      <div class="queue-tags" id="queue-tags">
        <span style="color:#C4B0E8;font-size:15px;font-weight:700;">아직 없어요</span>
      </div>
      <div class="btn-row">
        <button class="btn-outline" onclick="clearWords()">전체 지우기</button>
        <button class="btn-go" onclick="switchTab('student')">학생 모드로 → 🐣</button>
      </div>
    </div>
    <div class="card">
      <div class="share-inner">
        <div class="share-title">🔗 링크로 공유하기</div>
        <div class="share-desc">단어를 추가하면 링크가 생성돼요. 복사해서 학생에게 보내세요!</div>
        <div class="share-row">
          <textarea id="share-url" readonly placeholder="단어를 추가하면 링크가 생성됩니다"></textarea>
          <button class="btn-copy" onclick="copyLink()">복사</button>
        </div>
        <div class="copy-ok" id="copy-ok"></div>
      </div>
    </div>
  </div>

  <!-- 학생 패널 -->
  <div id="student-panel">
    <div class="info-banner" id="info-banner" style="display:none;">
      🎉 선생님이 준비한 단어로 연습해요!
    </div>
    <div id="typing-area"></div>
    <div class="reward-card">
      <div class="reward-header">
        <div class="reward-title">🥚 알 모으기</div>
        <div class="stage-badge badge-egg" id="stage-badge">🥚 알 모으는 중</div>
      </div>
      <div class="prog-outer"><div class="prog-inner" id="prog-bar" style="width:0%"></div></div>
      <div class="prog-label" id="prog-label">0 / 30개</div>
      <div class="eggs-grid" id="eggs-grid"></div>
    </div>
  </div>
</div>

<!-- 부화 오버레이 -->
<div class="burst-overlay" id="burst-overlay">
  <div class="burst-box">
    <span class="burst-emoji" id="burst-emoji">🐣</span>
    <div class="burst-title" id="burst-title">부화했어요!</div>
    <div class="burst-sub" id="burst-sub">알 10개를 모았어요!</div>
    <button class="btn-continue" onclick="closeBurst()">계속하기 🎉</button>
  </div>
</div>

<script>
let words=[], wordIdx=0, eggCount=0, pendingBurst=null;

const STAGES=[
  {at:0,  emoji:'🥚', label:'알 모으는 중',  badge:'badge-egg',   title:'',                  sub:''},
  {at:10, emoji:'🐣', label:'병아리 탄생!',   badge:'badge-chick', title:'부화했어요! 🐣',      sub:'알 10개를 모았어요!'},
  {at:20, emoji:'🐤', label:'중닭으로 성장!', badge:'badge-mid',   title:'중닭이 됐어요! 🐤',   sub:'알 20개를 모았어요!'},
  {at:30, emoji:'🐔', label:'드디어 닭!',     badge:'badge-hen',   title:'드디어 닭이 됐어요! 🐔', sub:'알 30개를 다 모았어요!'},
];

function getStageIdx(n){
  let s=0;
  STAGES.forEach((st,i)=>{ if(n>=st.at) s=i; });
  return s;
}

function encodeWords(a){ return btoa(encodeURIComponent(a.join('|'))); }
function decodeWords(s){
  try{ return decodeURIComponent(atob(s)).split('|').filter(Boolean); }
  catch(e){ return []; }
}

function buildShareUrl(){
  if(!words.length) return '';
  const base = window.location.href.split('?')[0].split('#')[0];
  return base + '?w=' + encodeWords(words) + '&mode=student';
}

function updateShareUrl(){
  const el = document.getElementById('share-url');
  const url = buildShareUrl();
  el.value = url || '';
  el.placeholder = words.length ? '' : '단어를 추가하면 링크가 생성됩니다';
}

function copyLink(){
  const url = buildShareUrl();
  if(!url){ document.getElementById('copy-ok').textContent='먼저 단어를 추가해주세요!'; return; }
  navigator.clipboard.writeText(url).then(()=>{
    document.getElementById('copy-ok').textContent='✅ 복사됐어요! 학생에게 보내세요.';
    setTimeout(()=>document.getElementById('copy-ok').textContent='', 3000);
  }).catch(()=>{
    document.getElementById('share-url').select();
    document.getElementById('copy-ok').textContent='위 링크를 직접 선택해서 복사해주세요.';
  });
}

function switchTab(t){
  document.getElementById('tab-t').classList.toggle('active', t==='teacher');
  document.getElementById('tab-s').classList.toggle('active', t==='student');
  document.getElementById('teacher-panel').style.display = t==='teacher' ? 'block' : 'none';
  document.getElementById('student-panel').style.display  = t==='student' ? 'block' : 'none';
  if(t==='student'){ wordIdx=0; eggCount=0; renderWord(); renderEggs(); }
}

function addWord(){
  const inp = document.getElementById('teacher-input');
  const v = inp.value.trim();
  if(!v) return;
  words.push(v);
  inp.value='';
  renderQueue();
  updateShareUrl();
  inp.focus();
}

function removeWord(i){ words.splice(i,1); renderQueue(); updateShareUrl(); }
function clearWords(){ words=[]; renderQueue(); updateShareUrl(); }

function renderQueue(){
  const el = document.getElementById('queue-tags');
  if(!words.length){
    el.innerHTML='<span style="color:#C4B0E8;font-size:15px;font-weight:700;">아직 없어요</span>';
    return;
  }
  el.innerHTML = words.map((w,i)=>
    `<div class="qtag">${w}<button onclick="removeWord(${i})">×</button></div>`
  ).join('');
}

function renderWord(){
  const area = document.getElementById('typing-area');
  if(!words.length){
    area.innerHTML='<div class="no-words">👩‍🏫 선생님이 아직<br>단어를 추가하지 않았어요!</div>';
    return;
  }
  if(wordIdx >= words.length){
    area.innerHTML=`<div class="done-wrap">
      <span class="done-big">🎊</span>
      <div class="done-txt">모든 단어를 완성했어요!<br>정말 대단해요! 👏</div>
    </div>`;
    return;
  }
  area.innerHTML=`<div class="word-card">
    <div class="prompt-label">👇 따라 써보세요!</div>
    <div class="prompt-word" id="prompt-word"></div>
    <input type="text" id="student-input" placeholder="여기에 입력해요" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"/>
    <div class="feedback-msg" id="feedback-msg"></div>
    <button class="skip-btn" onclick="skipWord()">모르겠어요 (건너뛰기) 🙈</button>
  </div>`;
  renderChars(words[wordIdx], '');
  const inp = document.getElementById('student-input');
  inp.addEventListener('input', onStudentInput);
  inp.focus();
}

function renderChars(target, typed){
  const el = document.getElementById('prompt-word');
  if(!el) return;
  let html='';
  for(let i=0; i<target.length; i++){
    const ch = target[i]===' ' ? '\u00a0' : target[i];
    const cls = i < typed.length
      ? (typed[i]===target[i] ? 'ch-correct' : 'ch-wrong')
      : i===typed.length ? 'ch-current' : 'ch-pending';
    html += `<span class="${cls}">${ch}</span>`;
  }
  el.innerHTML = html;
}

function onStudentInput(e){
  if(wordIdx >= words.length) return;
  const target = words[wordIdx], typed = e.target.value;
  renderChars(target, typed);
  const fm = document.getElementById('feedback-msg');
  if(typed === target){
    e.target.className='ok';
    if(fm){ fm.textContent='🎉 정답! 알 하나 획득!'; fm.className='feedback-msg good'; }
    eggCount++;
    renderEggs();
    const bust = STAGES.find(s=>s.at===eggCount && s.at>0);
    if(bust){ pendingBurst=bust; setTimeout(showBurst, 400); }
    else setTimeout(()=>{ wordIdx++; renderWord(); }, 600);
  } else if(typed.length >= target.length){
    e.target.className='ng';
    if(fm){ fm.textContent='🙈 다시 해봐요!'; fm.className='feedback-msg bad'; }
  } else {
    e.target.className='';
    if(fm){ fm.textContent=''; fm.className='feedback-msg'; }
  }
}

function skipWord(){ wordIdx++; renderWord(); }

function renderEggs(){
  const grid = document.getElementById('eggs-grid');
  const MAX = 30;
  let html='';
  for(let i=0; i<MAX; i++){
    const filled = i < eggCount;
    const si = getStageIdx(i+1);
    const emoji = STAGES[si].emoji;
    html += `<div class="egg-slot${filled?' filled':''}">${filled ? emoji : ''}</div>`;
  }
  grid.innerHTML = html;
  const si = getStageIdx(eggCount);
  const st = STAGES[si];
  const badge = document.getElementById('stage-badge');
  badge.textContent = st.emoji+' '+st.label;
  badge.className = 'stage-badge '+st.badge;
  const pct = Math.min(100, Math.round((eggCount/MAX)*100));
  document.getElementById('prog-bar').style.width = pct+'%';
  document.getElementById('prog-label').textContent = eggCount+' / 30개';
}

function showBurst(){
  if(!pendingBurst) return;
  document.getElementById('burst-emoji').textContent = pendingBurst.emoji;
  document.getElementById('burst-title').textContent = pendingBurst.title;
  document.getElementById('burst-sub').textContent   = pendingBurst.sub;
  document.getElementById('burst-overlay').style.display = 'flex';
}

function closeBurst(){
  document.getElementById('burst-overlay').style.display = 'none';
  pendingBurst = null;
  wordIdx++;
  renderWord();
}

document.getElementById('teacher-input').addEventListener('keydown', e=>{
  if(e.key==='Enter') addWord();
});

(function init(){
  try{
    const params = new URLSearchParams(window.location.search);
    const w    = params.get('w');
    const mode = params.get('mode');
    if(w){ words = decodeWords(w); renderQueue(); updateShareUrl(); }
    if(mode==='student' && words.length){
      switchTab('student');
      document.getElementById('info-banner').style.display='block';
    }
  } catch(e){}
})();
</script>
</body>
</html>
